# Copy this file to terraform.tfvars and replace every placeholder.
# Never commit terraform.tfvars: it is ignored by the repository .gitignore.

aws_region  = "eu-central-1"
aws_profile = "REPLACE_WITH_AWS_CLI_PROFILE"

cluster_name = "REPLACE_WITH_CLUSTER_NAME"

vpc_id = "vpc-REPLACE_ME"
subnet_ids = [
  "subnet-REPLACE_ME_1",
  "subnet-REPLACE_ME_2",
]

# Replace with the public IPv4 address of the administrator workstation.
cluster_endpoint_public_access_cidrs = ["203.0.113.10/32"]

node_instance_types = ["t3.small"]

# Group 13 example from the assignment. Change the cluster label if needed.
argocd_hostname = "argocd.mikoladolia.pp.ua"

# Set to a public Route53 hosted zone ID only when that zone is managed in
# this AWS account. Leave null when the curator or another DNS provider owns it.
argocd_route53_zone_id = null

tags = {
  Environment = "diploma"
  ManagedBy   = "Terraform"
  Project     = "dan-it-devops-diploma"
}
