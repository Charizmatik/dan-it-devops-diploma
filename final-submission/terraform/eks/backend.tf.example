# Optional remote-state configuration.
# Copy this file to backend.tf only after creating a dedicated S3 bucket and,
# if used, a DynamoDB lock table. Never reuse the course sample state key.

terraform {
  backend "s3" {
    bucket         = "REPLACE_WITH_UNIQUE_STATE_BUCKET"
    key            = "REPLACE_WITH_CLUSTER_NAME/eks/terraform.tfstate"
    region         = "eu-central-1"
    encrypt        = true
    dynamodb_table = "REPLACE_WITH_LOCK_TABLE"
  }
}
